<odoo>
    <record id="view_payroll_form_inh" model="ir.ui.view">
        <field name="name">view_payroll_form_inh</field>
        <field name="model">hr.ph.payroll</field>
        <field name="inherit_id" ref="ez_payroll.view_payroll_form"/>
        <field name="arch" type="xml">
            <button name="del_blank"  position="before">
                <button name="action_merge_leaves" type="object"
                    confirm="Are you sure you want to merge leaves?"
                    invisible="state not in ('draft')"
                    string="Merge Leaves"/>
                <button name="action_del_lates_undertime" type="object"
                    confirm="Are you sure you want to delete lates and undertimes?"
                    invisible="state not in ('draft')"
                    string="Delete Late/UT"/>
            </button>

            <button name="cancel_done" position="attributes">
                <attribute name="invisible">state not in ('done','released')</attribute>
            </button>

            <button name="cancel_done" position="before">
                <button name="action_release" type="object"
                    confirm="Are you sure you want to release payslips to employees?"
                    invisible="state not in ('done')"
                    class="oe_highlight" string="Release"/>
            </button>

        </field>
    </record>

    <record id="ez_payroll.open_payslip" model="ir.actions.act_window">
        <field name="domain">[('state','=','released')]</field>
    </record>

</odoo>