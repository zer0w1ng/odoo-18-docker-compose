    <record id="helpdesk_tag_tk" model="helpdesk.ticket.tag">
        <field name="name">Timekeeping</field>
        <field name="color">1</field>
    </record>

    <record id="helpdesk_tag_timeoff" model="helpdesk.ticket.tag">
        <field name="name">Time Off</field>
        <field name="color">2</field>
    </record>

    <record id="helpdesk_tag_payroll" model="helpdesk.ticket.tag">
        <field name="name">Payroll</field>
        <field name="color">3</field>
    </record>

    <record id="helpdesk_tag_hr" model="helpdesk.ticket.tag">
        <field name="name">HR Services</field>
        <field name="color">4</field>
    </record>

    <record id="helpdesk_tag_gov_ben" model="helpdesk.ticket.tag">
        <field name="name">Government Benefits</field>
        <field name="color">5</field>
    </record>

    <record id="helpdesk_tag_comp_ben" model="helpdesk.ticket.tag">
        <field name="name">Company Granted Benefits</field>
        <field name="color">6</field>
    </record>

    <record id="helpdesk_categ_simple" model="helpdesk.ticket.category">
