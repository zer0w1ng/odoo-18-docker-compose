    <record id="helpdesk_team_gov_ben" model="helpdesk.ticket.team">
        <field name="name">Government Benefits</field>
    </record>

    <record id="helpdesk_team_comp_ben" model="helpdesk.ticket.team">
        <field name="name">Company Granted Benefits</field>
    </record>

