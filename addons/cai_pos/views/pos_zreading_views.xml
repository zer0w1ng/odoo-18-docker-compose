<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Z-Reading Tree View -->
    <record id="view_pos_zreading_tree" model="ir.ui.view">
        <field name="name">pos.zreading.tree</field>
        <field name="model">pos.zreading</field>
        <field name="arch" type="xml">
            <list string="Z-Reading Reports" create="false" edit="false"
                  decoration-success="state == 'printed'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'draft'">
                <field name="reading_number"/>
                <field name="reading_date"/>
                <field name="reading_datetime"/>
                <field name="user_id"/>
                <field name="session_count"/>
                <field name="transaction_count"/>
                <field name="gross_sales" sum="Total Gross Sales" widget="monetary"/>
                <field name="total_discounts" sum="Total Discounts" widget="monetary"/>
                <field name="net_sales" sum="Total Net Sales" widget="monetary"/>
                <field name="new_grand_total" widget="monetary"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'printed'" 
                       decoration-info="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- Z-Reading Form View -->
    <record id="view_pos_zreading_form" model="ir.ui.view">
        <field name="name">pos.zreading.form</field>
        <field name="model">pos.zreading</field>
        <field name="arch" type="xml">
            <form string="Z-Reading Report" create="false" edit="false">
                <header>
                    <button name="action_print_zreading" 
                            string="Download PDF" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-download"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,printed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" 
                                name="action_print_zreading" icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print Report</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="reading_number"/>
                        </h1>
                        <h3 style="margin-top: 5px;">
                            Z-Reading for <field name="reading_date" readonly="1"/>
                        </h3>
                    </div>

                    <group>
                        <group name="header_left">
                            <field name="reading_datetime"/>
                            <field name="user_id"/>
                            <field name="bir_config_id"/>
                        </group>
                        <group name="header_right">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="session_count"/>
                            <field name="transaction_count"/>
                            <field name="voided_transaction_count" invisible="voided_transaction_count == 0"/>
                            <field name="refund_count" invisible="refund_count == 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sales Summary" name="sales">
                            <group>
                                <group name="sales_amounts">
                                    <field name="gross_sales" widget="monetary"/>
                                    <field name="total_discounts" widget="monetary"/>
                                    <separator/>
                                    <field name="net_sales" widget="monetary" 
                                           style="font-weight: bold; font-size: 1.1em;"/>
                                </group>
                                <group name="vat_amounts">
                                    <field name="vatable_sales" widget="monetary"/>
                                    <field name="vat_amount" widget="monetary"/>
                                    <field name="vat_exempt_sales" widget="monetary"/>
                                    <field name="zero_rated_sales" widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <page string="Payment Summary" name="payments">
                            <group>
                                <group>
                                    <field name="cash_payments" widget="monetary"/>
                                    <field name="card_payments" widget="monetary"/>
                                    <field name="other_payments" widget="monetary"/>
                                </group>
                                <group>
                                    <separator string="Total Payments"/>
                                    <label for="net_sales" string="Total"/>
                                    <div>
                                        <field name="net_sales" widget="monetary" nolabel="1"
                                               style="font-weight: bold; font-size: 1.1em;"/>
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="Grand Totals" name="grand_totals">
                            <group>
                                <group>
                                    <field name="old_grand_total" widget="monetary"/>
                                    <field name="net_sales" string="+ Period Sales" widget="monetary"/>
                                </group>
                                <group>
                                    <separator string="Accumulated Total"/>
                                    <field name="new_grand_total" widget="monetary"
                                           style="font-weight: bold; font-size: 1.2em; color: #2e7d32;"/>
                                </group>
                            </group>
                        </page>

                        <page string="Adjustments" name="adjustments" invisible="voided_amount == 0 and refund_amount == 0">
                            <group>
                                <group string="Voided Transactions" invisible="voided_amount == 0">
                                    <field name="voided_transaction_count"/>
                                    <field name="voided_amount" widget="monetary"/>
                                </group>
                                <group string="Refund Transactions" invisible="refund_amount == 0">
                                    <field name="refund_count"/>
                                    <field name="refund_amount" widget="monetary"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert" invisible="voided_amount == 0">
                                <i class="fa fa-info-circle" title="Information"/> 
                                <strong>Voided transactions</strong> are excluded from sales totals as per BIR requirements.
                            </div>
                            <div class="alert alert-warning" role="alert" invisible="refund_amount == 0">
                                <i class="fa fa-exclamation-triangle" title="Warning"/> 
                                <strong>Refund transactions</strong> reduce the net sales and are tracked separately for BIR reporting.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Z-Reading Search View -->
    <record id="view_pos_zreading_search" model="ir.ui.view">
        <field name="name">pos.zreading.search</field>
        <field name="model">pos.zreading</field>
        <field name="arch" type="xml">
            <search string="Search Z-Readings">
                <field name="reading_number"/>
                <field name="reading_date"/>
                <field name="user_id"/>
                <field name="bir_config_id"/>
                
                <filter string="Today" name="today"
                        domain="[('reading_date', '=', context_today())]"/>
                <filter string="This Week" name="week"
                        domain="[('reading_date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="month"
                        domain="[('reading_date', '&gt;=', time.strftime('%Y-%m-01'))]"/>
                
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Printed" name="printed" domain="[('state','=','printed')]"/>
                
                <separator/>
                <filter string="My Z-Readings" name="my_zreadings"
                        domain="[('user_id', '=', uid)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Date" name="group_date" context="{'group_by': 'reading_date'}"/>
                    <filter string="Generated By" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'reading_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Z-Reading Action -->
    <record id="action_pos_zreading" model="ir.actions.act_window">
        <field name="name">Z-Reading Reports</field>
        <field name="res_model">pos.zreading</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Z-Reading reports yet
            </p>
            <p>
                Z-Reading reports are daily sales summaries required for BIR compliance.
                They can only be generated once per day after all POS sessions are closed.
            </p>
            <p>
                <a type="action" name="%(action_generate_zreading_wizard)d" class="btn btn-primary">
                    Generate Z-Reading
                </a>
            </p>
        </field>
    </record>

</odoo>

