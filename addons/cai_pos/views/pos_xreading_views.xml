<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- X-Reading Tree View -->
    <record id="view_pos_xreading_tree" model="ir.ui.view">
        <field name="name">pos.xreading.tree</field>
        <field name="model">pos.xreading</field>
        <field name="arch" type="xml">
            <list string="X-Reading Reports" create="false" edit="false">
                <field name="reading_number"/>
                <field name="reading_date"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <field name="transaction_count"/>
                <field name="period_sales" widget="monetary"/>
                <field name="new_grand_total" widget="monetary"/>
                <field name="z_counter"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- X-Reading Form View -->
    <record id="view_pos_xreading_form" model="ir.ui.view">
        <field name="name">pos.xreading.form</field>
        <field name="model">pos.xreading</field>
        <field name="arch" type="xml">
            <form string="X-Reading Report" create="false" edit="false">
                <header>
                    <button name="action_print_xreading" 
                            string="Print X-Reading" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" 
                                name="action_print_xreading" icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="reading_number"/>
                        </h1>
                    </div>

                    <group>
                        <group name="header_left">
                            <field name="reading_date"/>
                            <field name="session_id"/>
                            <field name="config_id"/>
                            <field name="bir_config_id"/>
                        </group>
                        <group name="header_right">
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="z_counter"/>
                            <field name="last_z_reading_date"/>
                        </group>
                    </group>

                    <group string="Reporting Period">
                        <group>
                            <field name="period_start_date"/>
                            <field name="period_end_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Transaction Summary" name="transactions">
                            <group>
                                <group name="transaction_counts">
                                    <field name="transaction_count"/>
                                    <field name="voided_transaction_count"/>
                                    <field name="refunded_transaction_count"/>
                                </group>
                            </group>
                        </page>

                        <page string="Sales Summary" name="sales">
                            <group>
                                <group name="sales_amounts">
                                    <field name="gross_sales" widget="monetary"/>
                                    <field name="total_discounts" widget="monetary"/>
                                    <field name="net_sales" widget="monetary"/>
                                </group>
                                <group name="vat_amounts">
                                    <field name="vatable_sales" widget="monetary"/>
                                    <field name="vat_amount" widget="monetary"/>
                                    <field name="vat_exempt_sales" widget="monetary"/>
                                    <field name="zero_rated_sales" widget="monetary"/>
                                </group>
                            </group>
                            
                            <separator string="Grand Totals"/>
                            <group>
                                <group>
                                    <field name="old_grand_total" widget="monetary"/>
                                    <field name="period_sales" widget="monetary"/>
                                </group>
                                <group>
                                    <field name="new_grand_total" widget="monetary" 
                                           style="font-size: 18px; font-weight: bold;"/>
                                </group>
                            </group>
                        </page>

                        <page string="Discount Breakdown" name="discounts">
                            <field name="discount_line_ids">
                                <list create="false" edit="false" delete="false">
                                    <field name="discount_type_name"/>
                                    <field name="count"/>
                                    <field name="amount" widget="monetary"/>
                                </list>
                            </field>
                        </page>

                        <page string="Payment Breakdown" name="payments">
                            <field name="payment_line_ids">
                                <list create="false" edit="false" delete="false">
                                    <field name="payment_method_name"/>
                                    <field name="count"/>
                                    <field name="amount" widget="monetary"/>
                                </list>
                            </field>
                        </page>

                        <page string="Adjustments" name="adjustments">
                            <group>
                                <group>
                                    <field name="voided_amount" widget="monetary"/>
                                    <field name="refunded_amount" widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes or remarks..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- X-Reading Search View -->
    <record id="view_pos_xreading_search" model="ir.ui.view">
        <field name="name">pos.xreading.search</field>
        <field name="model">pos.xreading</field>
        <field name="arch" type="xml">
            <search string="Search X-Readings">
                <field name="reading_number"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="bir_config_id"/>
                
                <filter string="Today" name="today"
                        domain="[('reading_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('reading_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="This Week" name="week"
                        domain="[('reading_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="month"
                        domain="[('reading_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="My X-Readings" name="my_xreadings"
                        domain="[('user_id', '=', uid)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="POS Terminal" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                    <filter string="Cashier" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'reading_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- X-Reading Action -->
    <record id="action_pos_xreading" model="ir.actions.act_window">
        <field name="name">X-Reading Reports</field>
        <field name="res_model">pos.xreading</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No X-Reading reports yet
            </p>
            <p>
                X-Reading reports show non-reset sales summaries. Use the "Generate X-Reading" button in your POS session to create one.
            </p>
        </field>
    </record>

</odoo>

