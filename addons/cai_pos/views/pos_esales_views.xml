<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- eSales Report List View -->
    <record id="view_pos_esales_report_tree" model="ir.ui.view">
        <field name="name">pos.esales.report.tree</field>
        <field name="model">pos.esales.report</field>
        <field name="arch" type="xml">
            <list string="eSales Reports" create="false"
                  decoration-muted="state == 'draft'"
                  decoration-info="state == 'generated'"
                  decoration-success="state == 'submitted'">
                <field name="name"/>
                <field name="report_month" widget="date"/>
                <field name="total_net_sales" widget="monetary"/>
                <field name="total_vat_amount" widget="monetary"/>
                <field name="state" widget="badge" 
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'generated'"
                       decoration-success="state == 'submitted'"/>
                <field name="generated_date" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="filename" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- eSales Report Form View -->
    <record id="view_pos_esales_report_form" model="ir.ui.view">
        <field name="name">pos.esales.report.form</field>
        <field name="model">pos.esales.report</field>
        <field name="arch" type="xml">
            <form string="eSales Report">
                <header>
                    <button name="action_generate_csv" 
                            string="Generate Files" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Generate CSV and Excel files for BIR submission?"/>
                    
                    <button name="action_download_csv" 
                            string="Download CSV" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state == 'draft'"/>
                    
                    <button name="action_download_excel" 
                            string="Download Excel" 
                            type="object" 
                            class="btn-primary"
                            invisible="state == 'draft'"/>
                    
                    <button name="action_mark_submitted" 
                            string="Mark as Submitted" 
                            type="object"
                            invisible="state != 'generated'"
                            confirm="Mark this report as submitted to BIR?"/>
                    
                    <button name="action_reset_to_draft" 
                            string="Reset to Draft" 
                            type="object"
                            invisible="state == 'draft' or state == 'submitted'"
                            confirm="Reset this report to draft? The files will be removed."/>
                    
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,generated,submitted"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_csv" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="state != 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Generate</span>
                                <span class="o_stat_text">Files</span>
                            </div>
                        </button>
                        
                        <button name="action_download_csv" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-download"
                                invisible="state == 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Download</span>
                                <span class="o_stat_text">CSV File</span>
                            </div>
                        </button>
                        
                        <button name="action_download_excel" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-excel-o"
                                invisible="state == 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Download</span>
                                <span class="o_stat_text">Excel File</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Report Information">
                            <field name="report_month" widget="date" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="bir_config_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="File Information">
                            <field name="filename" readonly="1"/>
                            <field name="csv_filename" readonly="1" invisible="not csv_filename"/>
                            <field name="excel_filename" readonly="1" invisible="not excel_filename"/>
                            <field name="generated_date" readonly="1" invisible="not generated_date"/>
                            <field name="submitted_date" readonly="1" invisible="not submitted_date"/>
                        </group>
                    </group>
                    
                    <group string="Summary Totals">
                        <group>
                            <field name="total_gross_sales" widget="monetary"/>
                            <field name="total_discounts" widget="monetary"/>
                            <field name="total_net_sales" widget="monetary"/>
                        </group>
                        <group>
                            <field name="total_vatable_sales" widget="monetary"/>
                            <field name="total_vat_amount" widget="monetary"/>
                            <field name="total_vat_exempt_sales" widget="monetary"/>
                            <field name="total_zero_rated_sales" widget="monetary"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Daily Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="Daily Sales" 
                                      decoration-muted="net_sales == 0"
                                      editable="bottom">
                                    <field name="date" string="Date" width="120px"/>
                                    <field name="gross_sales" string="Gross" sum="Total" widget="monetary"/>
                                    <field name="sc_disc" string="SC Disc" sum="Total" widget="monetary" optional="hide"/>
                                    <field name="pwd_disc" string="PWD Disc" sum="Total" widget="monetary" optional="show"/>
                                    <field name="total_discounts" string="Tot. Disc" sum="Total" widget="monetary"/>
                                    <field name="net_sales" string="Net" sum="Total" widget="monetary"/>
                                    <field name="vatable_sales" string="VATable" sum="Total" widget="monetary" optional="show"/>
                                    <field name="vat_amount" string="VAT" sum="Total" widget="monetary" optional="show"/>
                                    <field name="vat_exempt_sales" string="VAT-Exempt" sum="Total" widget="monetary" optional="show"/>
                                    <field name="zero_rated_sales" string="Zero-Rated" sum="Total" widget="monetary" optional="show"/>
                                    <field name="or_count" string="OR#" sum="Total" optional="hide"/>
                                    <field name="begin_or" string="Begin OR" optional="hide"/>
                                    <field name="end_or" string="End OR" optional="hide"/>
                                </list>
                                <form string="Daily Sales">
                                    <group>
                                        <group string="Basic Information">
                                            <field name="date" widget="date"/>
                                            <field name="old_grand_total" widget="monetary"/>
                                            <field name="new_grand_total" widget="monetary"/>
                                        </group>
                                        <group string="Receipt Range">
                                            <field name="begin_or"/>
                                            <field name="end_or"/>
                                            <field name="or_count"/>
                                            <field name="terminal_read_count"/>
                                        </group>
                                    </group>
                                    
                                    <group string="Sales">
                                        <group>
                                            <field name="gross_sales" widget="monetary"/>
                                            <field name="total_discounts" widget="monetary"/>
                                            <field name="net_sales" widget="monetary"/>
                                            <field name="total_sales" widget="monetary"/>
                                        </group>
                                        <group>
                                            <field name="vatable_sales" widget="monetary"/>
                                            <field name="vat_amount" widget="monetary"/>
                                            <field name="vat_exempt_sales" widget="monetary"/>
                                            <field name="zero_rated_sales" widget="monetary"/>
                                        </group>
                                    </group>
                                    
                                    <group string="Discounts">
                                        <group>
                                            <field name="sc_disc" widget="monetary"/>
                                            <field name="pwd_disc" widget="monetary"/>
                                        </group>
                                        <group>
                                            <field name="athlete_mov_disc" widget="monetary"/>
                                            <field name="other_disc" widget="monetary"/>
                                        </group>
                                    </group>
                                    
                                    <group string="Other">
                                        <group>
                                            <field name="service_charge" widget="monetary"/>
                                            <field name="whtax" widget="monetary"/>
                                        </group>
                                        <group>
                                            <field name="refund_amount" widget="monetary"/>
                                            <field name="void_amount" widget="monetary"/>
                                            <field name="vat_from_disc" widget="monetary"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        
                        <page string="Instructions" name="instructions">
                            <div style="padding: 20px;">
                                <h3>BIR eSales Report Instructions</h3>
                                
                                <h4 style="margin-top: 20px;">1. Generate CSV File</h4>
                                <p>Click the "Generate CSV" button to create the CSV file in BIR format.</p>
                                
                                <h4 style="margin-top: 20px;">2. Download CSV File</h4>
                                <p>Click "Download CSV" to save the file to your computer.</p>
                                
                                <h4 style="margin-top: 20px;">3. Submit to BIR</h4>
                                <p>
                                    <strong>Submission Deadlines:</strong><br/>
                                    • If TIN ends in even digit (0,2,4,6,8): Submit by 8th of following month<br/>
                                    • If TIN ends in odd digit (1,3,5,7,9): Submit by 10th of following month<br/>
                                    <br/>
                                    <strong>Penalties:</strong> ₱1,000 per month per machine for late/non-submission
                                </p>
                                
                                <h4 style="margin-top: 20px;">4. Mark as Submitted</h4>
                                <p>After submitting to BIR, click "Mark as Submitted" to track submission status.</p>
                                
                                <h4 style="margin-top: 20px;">File Format</h4>
                                <p>
                                    <strong>Filename Format:</strong> POS SALES [TIN][BranchCode] MMYYYY F[Series].CSV<br/>
                                    <strong>Example:</strong> POS SALES 123456789000 01 112024 F001.CSV<br/>
                                    <br/>
                                    • TIN: 12 digits (9-digit TIN + 000)<br/>
                                    • Branch Code: 2 digits (01, 02, etc.)<br/>
                                    • MMYYYY: Month and Year (e.g., 112024 for November 2024)<br/>
                                    • Series: F001, F002, etc. (max 999 rows per file)
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- eSales Report Search View -->
    <record id="view_pos_esales_report_search" model="ir.ui.view">
        <field name="name">pos.esales.report.search</field>
        <field name="model">pos.esales.report</field>
        <field name="arch" type="xml">
            <search string="Search eSales Reports">
                <field name="name"/>
                <field name="report_month"/>
                <field name="company_id"/>
                <field name="bir_config_id"/>
                
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Generated" name="generated" domain="[('state', '=', 'generated')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                
                <separator/>
                <filter string="This Year" name="this_year" 
                        domain="[('report_month', '&gt;=', context_today().strftime('%Y-01-01')), 
                                 ('report_month', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                <filter string="Last Month" name="last_month" 
                        domain="[('report_month', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), 
                                 ('report_month', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Month" name="group_month" context="{'group_by': 'report_month'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- eSales Report Action -->
    <record id="action_pos_esales_report" model="ir.actions.act_window">
        <field name="name">eSales Reports</field>
        <field name="res_model">pos.esales.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No eSales reports yet
            </p>
            <p>
                Generate monthly eSales CSV reports for BIR submission.<br/>
                Use the "Generate eSales Report" wizard to create reports.
            </p>
            <p>
                <a type="action" name="%(action_generate_esales_wizard)d" class="btn btn-primary">
                    Generate eSales Report
                </a>
            </p>
        </field>
    </record>

</odoo>

